# Candidate image versions; validate/finalize together before the workshop.
# ERPNext image bundles Frappe; do not select an independent Frappe image.
ERPNEXT_VERSION=v16.55.0
MARIADB_VERSION=11.8
REDIS_VERSION=8.6-alpine
# Match upstream's amd64 ERPNext runtime. Apple Silicon needs emulation.
ERPNEXT_PLATFORM=linux/amd64

# One local site, routed by the frontend regardless of the browser Host header.
SITE_NAME=erpnext.localhost
HTTP_PORT=8080
ERPNEXT_BASE_URL=http://localhost:8080

# REQUIRED: fill in .env only. Use distinct, strong local development passwords.
# Single-quote values containing $ or # using Compose .env syntax.
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Future ERPNext HTTP client; not consumed by the infrastructure scripts.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
